# Copy to .env and fill in, OR use the desktop 「设置」dialog
# (writes settings.json — also gitignored). Do NOT commit real keys.

# SiliconFlow (required for ASR + translation)
SILICONFLOW_API_KEY=
# Optional override (default https://api.siliconflow.cn/v1)
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ASR model: qwen-sf | sensevoice
# Aliases: Qwen/Qwen3-ASR-1.7B | FunAudioLLM/SenseVoiceSmall
ASR_PROVIDER=qwen-sf

# Latency: realtime (1.5s+0.5s) | accurate (6.5s+1.2s, default) | precise (8.0s+1.5s)
ASR_LATENCY_PRESET=accurate
# ASR_CHUNK_SECONDS=6.5
# ASR_OVERLAP_SECONDS=1.2

# Language lock for desktop overlay: ja | zh | en | auto
ASR_LANGUAGE=ja

# Bilingual secondary line → 简体中文 (same SiliconFlow key)
BILINGUAL=1
TRANSLATE_TARGET=zh
TRANSLATE_MODEL=Qwen/Qwen3-8B
